# ./setup.sh creates .env from this for you.

# The laptop's IP in your WLAN. Only this address gets the published port.
BIND_IP=192.168.1.50
PORT=9001

# Your user and group id on the laptop (`id -u`, `id -g`), so ./data stays yours.
PUID=1000
PGID=1000

# Used once by `tasting.manage init`. Commas separate names.
PLAYERS=Der Lenny,Milka,Spargehirn,Waschschlappen,Rentier
